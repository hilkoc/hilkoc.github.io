---
/* Runs a mobile-first site inside a phone mockup on wide screens. On phones the frame
   would be pointless, so it is replaced by a plain launch button. */
interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
---
<div class="phone-wrap">
  <div class="phone" aria-label={`Live preview: ${title}`}>
    <div class="notch" aria-hidden="true"></div>
    <iframe src={src} title={title} loading="lazy"></iframe>
  </div>
  <p class="hint muted">Live preview. Swipe or use the arrow keys inside the phone.</p>
</div>
<a href={src} class="btn btn-primary mobile-launch">Open {title} ↗</a>

<style>
  .phone-wrap {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  .phone {
    position: relative;
    width: 360px;
    height: 740px;
    padding: 14px;
    border-radius: 48px;
    background: #111;
    box-shadow:
      0 0 0 2px #2a2a2a,
      0 0 0 6px #0b0b0b,
      0 30px 80px -20px var(--glow),
      var(--shadow);
  }
  .notch {
    position: absolute;
    top: 22px;
    left: 50%;
    width: 92px;
    height: 24px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
    z-index: 1;
  }
  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 36px;
    background: #fff;
  }
  .hint {
    font: 0.85rem var(--font-sans);
    margin: 0;
  }
  .mobile-launch {
    display: none;
  }
  @media (max-width: 48rem) {
    .phone-wrap {
      display: none;
    }
    .mobile-launch {
      display: inline-flex;
    }
  }
</style>
