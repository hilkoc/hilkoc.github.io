---
/* Loads a heavy live demo only when the reader asks for it, to save GPU and battery. */
interface Props {
  src: string;
  title: string;
  cta: string;
  ratio?: string;
}
const { src, title, cta, ratio = '16 / 9' } = Astro.props;
---
<div class="ctl" style={`aspect-ratio: ${ratio}`} data-ctl data-src={src} data-title={title}>
  <slot />
  <button type="button" class="ctl-btn btn btn-primary">▶ {cta}</button>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-ctl]')) {
    box.querySelector('button')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = box.dataset.src ?? '';
      frame.title = box.dataset.title ?? '';
      frame.allow = 'fullscreen';
      frame.loading = 'eager';
      box.replaceChildren(frame);
      frame.focus();
    });
  }
</script>

<style>
  .ctl {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-soft);
    box-shadow: var(--shadow);
  }
  .ctl > :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ctl-btn {
    position: relative;
    z-index: 1;
  }
  .ctl :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
