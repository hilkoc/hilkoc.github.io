---
/* Mark: the unit circle with a secant through a rational point, the book's first idea. */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <rect width="32" height="32" rx="8" fill="var(--accent)"></rect>
  <circle cx="16" cy="16" r="9" fill="none" stroke="var(--accent-contrast)" stroke-width="2.2"></circle>
  <line x1="4" y1="22.5" x2="28" y2="10.5" stroke="var(--accent-contrast)" stroke-width="1.6" stroke-linecap="round" opacity="0.75"></line>
  <circle cx="8.2" cy="20.4" r="2.3" fill="var(--accent-contrast)"></circle>
  <circle cx="24.2" cy="12.4" r="2.3" fill="var(--accent-contrast)"></circle>
</svg>
