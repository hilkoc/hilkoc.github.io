---
/* Per-page view count from GoatCounter. Decoration: if the fetch fails or an ad blocker
   stops it, the element stays hidden and nothing else changes. */
import { GOAT_CODE } from '../data/site';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<span class:list={['view-count', className]} data-view-count data-goat={GOAT_CODE} hidden></span>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-view-count]')) {
    const code = el.dataset.goat;
    if (!code || location.hostname === 'localhost' || location.hostname === '127.0.0.1') continue;
    const url = `https://${code}.goatcounter.com/counter/${encodeURIComponent(location.pathname)}.json`;
    fetch(url)
      .then((res) => (res.ok ? res.json() : null))
      .then((data: { count?: string } | null) => {
        if (!data?.count) return;
        const n = data.count.trim();
        el.textContent = `${n} ${n === '1' ? 'view' : 'views'}`;
        el.hidden = false;
      })
      .catch(() => {});
  }
</script>
