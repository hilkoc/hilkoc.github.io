---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, tagSlug, type Post } from '../../../data/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <div class="container narrow">
    <header class="page-head">
      <p class="eyebrow"><a href="/blog/">Blog</a> / tag</p>
      <h1>#{tag}</h1>
      <p class="lede">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </header>
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

<style>
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
</style>
