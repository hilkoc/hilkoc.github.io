---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Message sent" showViews={false}>
  <div class="container narrow">
    <header class="page-head">
      <p class="eyebrow">Contact</p>
      <h1>Thank you</h1>
      <p class="lede">Your message is on its way. If you left an email address, I will reply there.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Back home</a>
        <a class="btn btn-secondary" href="/book/">Read the book</a>
      </div>
    </header>
  </div>
</BaseLayout>
