---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import ViewCount from '../components/ViewCount.astro';
import { formatDate, readingMinutes, tagSlug, type Post } from '../data/posts';
import { SITE } from '../data/site';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}
const { post, prev, next } = Astro.props;
const { title, description, date, updated, tags } = post.data;
---
<BaseLayout title={title} description={description} type="article" showViews={false}>
  <article class="container narrow">
    <header class="page-head">
      <p class="eyebrow"><a href="/blog/">Blog</a></p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="meta">
        <span>{SITE.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(updated)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post)} min read</span>
        <ViewCount />
      </p>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((t) => <a class="tag" href={`/blog/tags/${tagSlug(t)}/`}>#{t}</a>)}
          </p>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>

    <nav class="pager" aria-label="More posts">
      {prev ? <a href={`/blog/${prev.id}/`} class="card"><span class="muted">← Newer</span>{prev.data.title}</a> : <span />}
      {next ? <a href={`/blog/${next.id}/`} class="card right"><span class="muted">Older →</span>{next.data.title}</a> : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font: 0.9rem var(--font-sans);
    color: var(--text-muted);
  }
  .meta :global([data-view-count])::before {
    content: '·';
    margin-right: 0.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-16);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-4) var(--space-6);
    font: 600 0.95rem var(--font-sans);
    text-decoration: none;
  }
  .pager a span {
    font-weight: 500;
    font-size: 0.8rem;
  }
  .pager .right {
    text-align: right;
  }
</style>
